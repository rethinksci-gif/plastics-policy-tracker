---
import Base from '../../layouts/Base.astro';
import { STAGES, dossiers, stageLabel, fmtDate, jurName, url } from '../../lib/data';
const ds = await dossiers();
const uniq = (xs: string[]) => [...new Set(xs)].sort();
const jurs = uniq(ds.map((d) => d.jurisdiction));
const topics = uniq(ds.flatMap((d) => d.topics));
const stages = [...STAGES, 'withdrawn', 'stalled'].filter((s) => ds.some((d) => d.stage === s));
---
<Base title="Dossiers" description="Every tracked plastics law and regulation, filterable by jurisdiction, topic, stage and impact.">
  <h1>Dossiers</h1>
  <p class="lede">One card per instrument: current stage, verified timeline, next steps and key dates.</p>
  <form class="filters" id="filters" aria-label="Filter dossiers">
    <input type="search" name="q" placeholder="Filter by name…" aria-label="Filter by name" />
    <select name="jur" aria-label="Jurisdiction"><option value="">All jurisdictions</option>{jurs.map((j) => <option value={j}>{jurName(j)}</option>)}</select>
    <select name="topic" aria-label="Topic"><option value="">All topics</option>{topics.map((t) => <option value={t}>{t}</option>)}</select>
    <select name="stage" aria-label="Stage"><option value="">All stages</option>{stages.map((s) => <option value={s}>{stageLabel(s)}</option>)}</select>
    <select name="impact" aria-label="Impact"><option value="">Any impact</option><option>high</option><option>medium</option><option>low</option></select>
  </form>
  <p class="small muted" id="count">{ds.length} dossiers</p>
  <div class="dlist" id="list">
    {ds.map((d) => {
      const last = d.updates[0];
      return (
        <article class="card dossier-row" data-jur={d.jurisdiction} data-topics={d.topics.join(' ')} data-stage={d.stage} data-impact={d.impact} data-name={`${d.title} ${d.short_title ?? ''} ${d.title_original ?? ''}`.toLowerCase()}>
          <h3><a href={url(`dossiers/${d.id}/`)}>{d.title}</a></h3>
          <div class="meta small">
            <span class="badge">{jurName(d.jurisdiction)}</span>
            <span class="badge stage">{stageLabel(d.stage)}</span>
            <span class={`badge ${d.impact}`}>{d.impact} impact</span>
            <span class="muted">{d.topics.join(' · ')}</span>
          </div>
          {last && <p class="small" style="margin:0.4rem 0 0"><strong>{fmtDate(last.date)}:</strong> {last.summary}</p>}
        </article>
      );
    })}
  </div>
  <script>
    const form = document.getElementById('filters') as HTMLFormElement;
    const rows = Array.from(document.querySelectorAll<HTMLElement>('#list > article'));
    const count = document.getElementById('count')!;
    const params = new URLSearchParams(location.search);
    for (const [k, v] of params) { const el = form.elements.namedItem(k) as HTMLInputElement | null; if (el) el.value = v; }
    function apply() {
      const f = new FormData(form);
      const q = String(f.get('q') || '').toLowerCase();
      let n = 0;
      for (const r of rows) {
        const ok = (!q || r.dataset.name!.includes(q)) &&
          (!f.get('jur') || r.dataset.jur === f.get('jur')) &&
          (!f.get('topic') || r.dataset.topics!.split(' ').includes(String(f.get('topic')))) &&
          (!f.get('stage') || r.dataset.stage === f.get('stage')) &&
          (!f.get('impact') || r.dataset.impact === f.get('impact'));
        r.hidden = !ok; if (ok) n++;
      }
      count.textContent = `${n} of ${rows.length} dossiers`;
      const p = new URLSearchParams(); for (const [k, v] of f) if (v) p.set(k, String(v));
      history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
    }
    form.addEventListener('input', apply); form.addEventListener('submit', (e) => e.preventDefault()); apply();
  </script>
</Base>
