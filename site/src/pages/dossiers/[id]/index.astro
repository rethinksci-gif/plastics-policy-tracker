---
import Base from '../../../layouts/Base.astro';
import {
  STAGES, fmtDate, instrumentName, issueOfReview, jurName, library, stageLabel, todayIso, url,
} from '../../../lib/data';

export async function getStaticPaths() {
  return (await library()).map((e) => ({ params: { id: e.d.id }, props: { e } }));
}
const { e } = Astro.props;
const d = e.d;
const issueMap = await issueOfReview();
const idx = STAGES.indexOf(d.stage);
const today = todayIso();
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
const fmtIssue = (slug: string) => `Issue ${Number(slug.split('-issue-')[1])}`;
---
<Base title={d.short_title ?? d.title} description={e.summary ?? `${d.title}: verified timeline of changes.`}>
  <p class="small muted"><a href={url('dossiers/')}>Laws &amp; policies</a> / {jurName(d.jurisdiction)}</p>
  <h1>{d.title}</h1>
  {d.title_original && <p class="muted" lang="und">{d.title_original}</p>}

  <dl class="glance">
    <div><dt>Type</dt><dd>{instrumentName(d.instrument)}</dd></div>
    <div><dt>Jurisdiction</dt><dd>{jurName(d.jurisdiction)}</dd></div>
    <div><dt>Current stage</dt><dd>{stageLabel(d.stage)}</dd></div>
    <div><dt>Impact</dt><dd><span class={`badge ${d.impact}`}>{d.impact}</span></dd></div>
    <div><dt>Last verified change</dt><dd>{e.lastChange ? fmtDate(e.lastChange) : '—'}</dd></div>
    <div><dt>Next date</dt><dd>{e.nextDate ? <>{fmtDate(e.nextDate.date)}<span class="small muted" style="font-weight:400"> — {e.nextDate.text}</span></> : '—'}</dd></div>
  </dl>

  {idx >= 0 ? (
    <div class="stagebar" aria-label="Legislative stage">
      {STAGES.map((s, i) => <span class={i < idx ? 'done' : i === idx ? 'now' : ''}>{stageLabel(s)}</span>)}
    </div>
  ) : <p><span class="badge draft">{stageLabel(d.stage)}</span></p>}

  {e.summary && (
    <>
      <p class="lede">{e.summary}</p>
      {e.summaryReviewId && <p class="small muted">Overview checked against the official sources · <a href={url(`reviews/${e.summaryReviewId}/`)}>review record</a></p>}
    </>
  )}
  {!e.summary && e.summaryStatus !== 'none' && (
    <p class="notice">The overview of this instrument is awaiting verification against its official sources{e.summaryStatus === 'failed' && e.summaryReviewId && <> (<a href={url(`reviews/${e.summaryReviewId}/`)}>see review</a>)</>}. The timeline below lists only verified changes.</p>
  )}

  <div class="subscribe" aria-label="Follow this law">
    <span class="small muted">Follow only this law:</span>
    <a href={url(`dossiers/${d.id}/rss.xml`)}>RSS feed</a>
    <a href={url(`dossiers/${d.id}/calendar.ics`)}>Calendar (.ics)</a>
  </div>

  <div class="grid2">
    <section>
      <h2>Timeline of verified changes</h2>
      {d.updates.length === 0 && (
        <p class="notice">No change has been verified yet. Every change shown here must be traced to an official source the
          pipeline can save; for this instrument that source is not yet available
          (<a href="https://github.com/rethinksci-gif/plastics-policy-tracker/blob/main/sources/unreachable.md">why</a>).</p>
      )}
      <ol class="timeline">
        {d.updates.map((u) => {
          const issue = issueMap.get(u.review_id);
          return (
            <li id={`change-${u.review_id}`}>
              <div class="date">{fmtDate(u.date)} {u.stage_change && <span class="badge stage">→ {stageLabel(u.stage_change)}</span>}</div>
              <div>{u.summary}</div>
              <details>
                <summary>Source quote{u.source_lang !== 'en' ? ` (${u.source_lang}, with translation)` : ''}</summary>
                <blockquote lang={u.source_lang}>{u.source_quote}</blockquote>
                {u.source_quote_en && <blockquote><em>English translation:</em> {u.source_quote_en}</blockquote>}
              </details>
              <div class="small muted">
                Source: <a href={u.source_url} rel="noopener">{host(u.source_url)}</a> ·
                Review <a href={url(`reviews/${u.review_id}/`)}><code>{u.review_id}</code></a>
                {issue && <> · reported in <a href={url(`issues/${issue}/`)}>{fmtIssue(issue)}</a></>}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
    <aside>
      <h2>Next steps</h2>
      {d.next_steps.length === 0 && <p class="muted small">None recorded.</p>}
      <ul class="events">
        {d.next_steps.map((n) => (
          <li>
            <div class="when">{fmtDate(n.date)} {(n.status === 'to-be-confirmed' || n.date < today.slice(0, n.date.length)) && <span class="badge draft">to be confirmed</span>}</div>
            <div class="small">{n.text} <a href={n.source_url} rel="noopener">source</a></div>
          </li>
        ))}
      </ul>
      <h2>Key dates</h2>
      {d.key_dates.length === 0 && <p class="muted small">None recorded.</p>}
      <ul class="events">
        {d.key_dates.map((k) => (
          <li><div class="when">{fmtDate(k.date)} {k.date < today.slice(0, k.date.length) && <span class="badge">past</span>}</div><div class="small">{k.text} {k.source_url && <a href={k.source_url} rel="noopener">source</a>}</div></li>
        ))}
      </ul>
      <h2>Affects</h2>
      <p class="small">{d.affected.join(', ')}</p>
      <h2>Topics</h2>
      <p class="small">{d.topics.map((t, i) => <>{i > 0 && ' · '}<a href={url(`dossiers/?topic=${encodeURIComponent(t)}`)}>{t}</a></>)}</p>
      <h2>Official sources</h2>
      <ul class="small">{d.official_links.map((l) => <li><a href={l} rel="noopener">{host(l)}</a></li>)}</ul>
    </aside>
  </div>
</Base>
