---
import '../styles/global.css';
import { SITE_NAME, url } from '../lib/data';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = 'Plastics laws and regulations worldwide, tracked and checked against official sources.', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const nav = [
  ['', 'Overview'], ['dossiers/', 'Laws & policies'], ['changes/', 'Changes'], ['calendar/', 'Calendar'],
  ['issues/', 'Archive'], ['verification/', 'How we verify'],
];
const isCurrent = (p: string) => (p === '' ? path === url('') || path === url('') + '/' : path.startsWith(url(p)));
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0d6b58" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={url('rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME}: all changes`} href={url('changes/rss.xml')} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#content" class="sr-skip">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href={url('')} aria-label={`${SITE_NAME} — home`}>
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--accent)"/><path d="M10 23V9h7a5 5 0 0 1 0 10h-7" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="brand-text">Plastics <span>Policy</span> Tracker</span>
        </a>
        <nav class="main" aria-label="Main">
          {nav.map(([p, label]) => <a href={url(p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <details class="menu">
          <summary class="icon-btn" aria-label="Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </summary>
          <nav class="menu-panel" aria-label="Main (mobile)">
            {nav.map(([p, label]) => <a href={url(p)} aria-current={isCurrent(p) ? 'page' : undefined}>{label}</a>)}
            <a href={url('search/')}>Search</a>
            <a href={url('about/')}>About</a>
          </nav>
        </details>
        <div class="tools">
          <a class="icon-btn" href={url('search/')} aria-label="Search" title="Search">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </a>
          <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle colour theme" title="Toggle colour theme">
            <svg class="theme-icon-light" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="theme-icon-dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="content" data-pagefind-body={noindex ? undefined : ''}>
      <div class="wrap"><slot /></div>
    </main>
    <footer class="site">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <a class="brand" href={url('')}><span class="brand-text">Plastics <span>Policy</span> Tracker</span></a>
            <p class="small" style="max-width:38ch">Plastics laws and regulations worldwide, published every other Monday. Every fact is traced to an official source and passes four layers of review.</p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href={url('dossiers/')}>Laws &amp; policies</a></li>
              <li><a href={url('changes/')}>Latest changes</a></li>
              <li><a href={url('calendar/')}>Calendar</a></li>
              <li><a href={url('issues/')}>Archive</a></li>
            </ul>
          </div>
          <div>
            <h4>Subscribe</h4>
            <ul>
              <li><a href={url('rss.xml')}>Newsletter RSS</a></li>
              <li><a href={url('changes/rss.xml')}>All changes RSS</a></li>
              <li><a href={url('calendar.ics')}>Calendar (.ics)</a></li>
            </ul>
          </div>
          <div>
            <h4>About</h4>
            <ul>
              <li><a href={url('verification/')}>How we verify</a></li>
              <li><a href={url('about/')}>About</a></li>
              <li><a href="https://github.com/rethinksci-gif/plastics-policy-tracker">Source and review archive</a></li>
              <li><a href="https://github.com/rethinksci-gif/plastics-policy-tracker/issues/new">Report an error</a></li>
            </ul>
          </div>
        </div>
        <p class="foot-note">Not legal advice. Always rely on the official text. British English.</p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const m = document.querySelector('details.menu[open]');
          if (m) { m.removeAttribute('open'); m.querySelector('summary').focus(); }
        }
      });
      document.addEventListener('click', (e) => {
        const m = document.querySelector('details.menu[open]');
        if (m && !m.contains(e.target)) m.removeAttribute('open');
      });
    </script>
  </body>
</html>
